{
  "uid": "capacidad-pve01",
  "title": "Capacidad PVE01",
  "tags": [
    "andes",
    "capacidad"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "timezone": "browser",
  "editable": true,
  "description": "Fase 10.2 - capacidad del anfitrión. Conclusión y umbrales en docs/operacion/capacidad.md",
  "panels": [
    {
      "type": "stat",
      "title": "RAM disponible",
      "description": "Memoria disponible de PVE01. Alerta CapacidadRamPVE01 por debajo del 10 %.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * node_memory_MemAvailable_bytes{job=\"pve01\"} / node_memory_MemTotal_bytes{job=\"pve01\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 10
              },
              {
                "color": "green",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "RAM asignada a VM encendidas",
      "description": "Suma de la RAM configurada de las VM encendidas frente a la RAM de PVE01 (KSM y RAM fija).",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * andes_pve_vm_ram_bytes{estado=\"running\"} / on() node_memory_MemTotal_bytes{job=\"pve01\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 85
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "CPU PVE01 (5 min)",
      "description": "Uso medio de las 8 vCPU.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 - 100 * avg(rate(node_cpu_seconds_total{job=\"pve01\",mode=\"idle\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "local-lvm (thin pool)",
      "description": "Datos escritos en el thin pool. Si llega al 100 % las VM se congelan. Alerta CapacidadThinPool por encima del 85 %.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "andes_pve_thinpool_percent{tipo=\"datos\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Sobreasignación de disco",
      "description": "Tamaño virtual de todos los discos thin frente al tamaño real del pool.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "andes_pve_thinpool_asignado_bytes{tipo=\"discos\"} / ignoring(tipo) andes_pve_thinpool_asignado_bytes{tipo=\"pool\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 2
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "VM encendidas / apagadas",
      "description": "VM encendidas (sin contar plantillas).",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "expr": "andes_pve_vms{estado=\"running\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area"
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "RAM de PVE01",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "node_memory_MemTotal_bytes{job=\"pve01\"}",
          "legendFormat": "total",
          "refId": "A"
        },
        {
          "expr": "node_memory_MemTotal_bytes{job=\"pve01\"} - node_memory_MemAvailable_bytes{job=\"pve01\"}",
          "legendFormat": "usada",
          "refId": "B"
        },
        {
          "expr": "andes_pve_vm_ram_bytes{estado=\"running\"}",
          "legendFormat": "asignada a VM encendidas",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "CPU y carga de PVE01",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "targets": [
        {
          "expr": "100 - 100 * avg(rate(node_cpu_seconds_total{job=\"pve01\",mode=\"idle\"}[5m]))",
          "legendFormat": "CPU %",
          "refId": "A"
        },
        {
          "expr": "100 * avg(rate(node_cpu_seconds_total{job=\"pve01\",mode=\"iowait\"}[5m]))",
          "legendFormat": "iowait %",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Almacenamiento de PVE01",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "expr": "andes_pve_thinpool_percent{tipo=\"datos\"}",
          "legendFormat": "local-lvm datos",
          "refId": "A"
        },
        {
          "expr": "andes_pve_thinpool_percent{tipo=\"metadatos\"}",
          "legendFormat": "local-lvm metadatos",
          "refId": "B"
        },
        {
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"pve01\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"pve01\",mountpoint=\"/\"})",
          "legendFormat": "raíz (local)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Memoria por VM (uso real en el anfitrión)",
      "description": "RAM disponible dentro de cada Linux: indica si a una VM le sobra o le falta memoria.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "expr": "100 * node_memory_MemAvailable_bytes{job=\"node\"} / node_memory_MemTotal_bytes{job=\"node\"}",
          "legendFormat": "{{instance}} RAM libre %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 10
    }
  ]
}