{
  "uid": "slo-andes-app",
  "title": "SLO Andes App",
  "tags": ["slo", "andes"],
  "time": { "from": "now-7d", "to": "now" },
  "refresh": "1m",
  "schemaVersion": 39,
  "panels": [
    { "type": "stat", "title": "Disponibilidad (7 dias)", "gridPos": {"x":0,"y":0,"w":6,"h":6},
      "targets": [{ "expr": "sli:app_disponibilidad:ratio_7d", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 3,
        "thresholds": { "mode": "absolute", "steps": [ {"color":"red","value":null}, {"color":"green","value":0.99} ] } } } },
    { "type": "stat", "title": "Objetivo (SLO)", "gridPos": {"x":6,"y":0,"w":4,"h":6},
      "targets": [{ "expr": "vector(0.99)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 0, "color": {"mode":"fixed","fixedColor":"blue"} } } },
    { "type": "gauge", "title": "Presupuesto de error restante", "gridPos": {"x":10,"y":0,"w":7,"h":6},
      "targets": [{ "expr": "clamp_min(slo:app_presupuesto_restante:ratio_7d, 0)", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [ {"color":"red","value":null}, {"color":"orange","value":0.25}, {"color":"green","value":0.5} ] } } } },
    { "type": "stat", "title": "Minutos sin servicio (7 dias)", "gridPos": {"x":17,"y":0,"w":7,"h":6},
      "targets": [{ "expr": "slo:app_minutos_caida:7d", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "m", "decimals": 1,
        "thresholds": { "mode": "absolute", "steps": [ {"color":"green","value":null}, {"color":"orange","value":50}, {"color":"red","value":100.8} ] } } } },
    { "type": "timeseries", "title": "Disponibilidad por hora", "gridPos": {"x":0,"y":6,"w":12,"h":9},
      "targets": [{ "expr": "sli:app_disponibilidad:ratio_1h", "refId": "A", "legendFormat": "disponibilidad 1h" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0.9, "max": 1 } } },
    { "type": "timeseries", "title": "Sonda HTTPS (1 = responde)", "gridPos": {"x":12,"y":6,"w":12,"h":9},
      "targets": [{ "expr": "probe_success{job=\"blackbox-https\"}", "refId": "A", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter" } } } },
    { "type": "timeseries", "title": "Latencia de la sonda", "gridPos": {"x":0,"y":15,"w":24,"h":8},
      "targets": [{ "expr": "probe_duration_seconds{job=\"blackbox-https\"}", "refId": "A", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } } }
  ]
}
